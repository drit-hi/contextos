
# Dependencies (exclude at any directory level)
**/node_modules/

# Next.js
.next/
out/

# Production builds
build/

# Environment variables — never commit secrets
.env*
!.env.example

# Vercel
.vercel/

# Testing
coverage/

# Package managers
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Miscellaneous
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts
